{
    "name": "givanov95/laravel-activity-log",
    "description": "Who did what in a Laravel app: an append-only activity log with explicit actors (user and role, customer, guest, system), a scope (tenant or case), related models, old/new values with masking and GDPR scrubbing.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "activity", "activity-log", "audit-trail", "history", "changes"],
    "authors": [
        {
            "name": "Georgi Ivanov",
            "email": "joroz95@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "givanov95/laravel-git-hooks": "^1.1",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0|^13.0"
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M"
    },
    "autoload": {
        "psr-4": {
            "Givanov95\\LaravelActivityLog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Givanov95\\LaravelActivityLog\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Givanov95\\LaravelActivityLog\\ActivityLogServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "givanov95/laravel-git-hooks": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
